#
set_io clk_i 35
set_frequency clk_i 12
set_io --warn-no-port uart_rx_i 4
set_io --warn-no-port uart_tx_o 6


# outputs to HUB75 led matrix
# on pmod2 and pmod3 ports
set_io led_r_o[0] 25 # r1
set_io led_g_o[0] 23 # g1
set_io led_b_o[0] 27 # b1
set_io led_r_o[1] 31 # r2
set_io led_g_o[1] 28 # g2
set_io led_b_o[1] 34 # b2
set_io led_addr_o[4] 32 # e
set_io led_addr_o[0] 37 # a
set_io led_addr_o[1] 36 # b
set_io led_addr_o[2] 42 # c
set_io led_addr_o[3] 38 # d
set_io led_clk_o 44 # clk
set_io led_latch_o 43 # lat
set_io led_oe_n_o 46 # ~oe

#set_io hub_75_o[3] 26 # gnd
#set_io hub_75_o[15] 45 # gnd





